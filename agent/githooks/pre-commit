#!/bin/sh
# Git pre-commit hook: engagement data, PROJECT.md, GOAL.md and SCOPE.md never get committed (public repo).
# Same rule as .claude/hooks/guard_shell.py, but it also catches commits made by hand. core.hooksPath = agent/githooks.
bad=$(git diff --cached --name-only | grep -E '^(engagements/|PROJECT\.md$|GOAL\.md$|SCOPE\.md$)' \
      | grep -vE '^engagements/(README\.md|_TEMPLATE/)')
if [ -n "$bad" ]; then
  echo "pre-commit hook (agent/githooks): these files must stay out of git (engagement data / real targets):" >&2
  echo "$bad" >&2
  echo "Unstage them: git reset -q -- <file>" >&2
  exit 1
fi
exit 0
